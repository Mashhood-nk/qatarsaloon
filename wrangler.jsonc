{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barber-booking",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The React app is served as static assets; /api/* goes to the Worker first.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The platform's own domain. HTTPS certificates are created automatically.
  "routes": [
    { "pattern": "qatarsaloon.com", "custom_domain": true },
    { "pattern": "www.qatarsaloon.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "barber-db",
      "database_id": "c40abd55-a99c-4388-9bf4-567878e52ff4",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "barber-images"
    }
  ],
  "observability": { "enabled": true }
}
